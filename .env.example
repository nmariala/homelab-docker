# Homelab Docker environment.
# JANGAN commit file .env / .env.docker. Salin file ini menjadi .env.docker
# dan isi dengan nilai acak Anda sendiri. Hanya untuk environment
# Docker staging, BUKAN production native.

# PostgreSQL container
POSTGRES_DB=stock_docker
POSTGRES_USER=stock_docker_user
POSTGRES_PASSWORD=change-me

# Koneksi API ke PostgreSQL (di dalam Docker network)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stock_docker
DB_USER=stock_docker_user
DB_PASSWORD=change-me

# Credentials dashboard (dipakai API container)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=change-me-generate-random-long-string